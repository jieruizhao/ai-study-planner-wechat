.nav-row { display: flex; align-items: center; padding: 8rpx 0 24rpx; }
.nav-back { width: 90rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 42rpx; color: var(--ink); }
.nav-center { flex: 1; text-align: center; }
.sec-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; padding: 14rpx 6rpx 20rpx; }
.sec-title { font-size: 32rpx; font-weight: 700; flex-shrink: 0; }
.head-actions { display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; margin-left: auto; }
.head-action { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 68rpx; box-sizing: border-box; margin: 0; padding: 0 18rpx; border-radius: 18rpx; font-size: 24rpx; font-weight: 500; line-height: 1.4; white-space: nowrap; }
.head-action::after { border: 0; }
.head-action-add { background: var(--brand-weak); color: var(--brand-deep); }
.action-plus { font-size: 30rpx; line-height: 1; }
.head-action-clear { background: transparent; color: var(--ink-2); border: 2rpx solid var(--line); }
.action-count { min-width: 32rpx; padding: 2rpx 6rpx; box-sizing: border-box; border-radius: 20rpx; background: var(--brand-weak); color: var(--brand-deep); font-size: 20rpx; text-align: center; }
.head-action-pressed { opacity: .65; }
.head-action[disabled] { opacity: .45; background: transparent; color: var(--ink-3); }

.rem-card { display: flex; align-items: center; }
.rem-card.off { opacity: 0.55; }
.rem-left { font-size: 24rpx; color: var(--ink-3); min-width: 130rpx; }

.sub-card { text-align: left; }
.sub-t { font-size: 34rpx; font-weight: 700; margin-top: 12rpx; }
.sub-btn { display: inline-block; padding: 18rpx 40rpx; margin-top: 24rpx; }
.rem-actions { display:flex; flex-direction:column; gap:16rpx; margin-top:24rpx; }
.rem-actions .btn { font-size:25rpx; padding:18rpx; }
.off { opacity:.55; }
