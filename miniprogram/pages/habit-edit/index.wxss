.nav-row { display: flex; align-items: center; padding: 8rpx 0 24rpx; }
.nav-back { width: 100rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: var(--ink); }
.nav-center { flex: 1; text-align: center; }

.input-box {
  background: var(--card-soft);
  border-radius: 16rpx; padding: 26rpx 26rpx;
}
.chan-row { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 2rpx solid var(--line-soft); }
.chan-row:last-child { border-bottom: none; }
.chan-check {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 3rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  color: transparent; font-size: 24rpx; font-weight: 700;
  box-sizing: border-box;
}
.chan-check.on { background: var(--brand); border-color: var(--brand); color: var(--brand-on); }
.del-link { text-align: center; color: var(--danger); font-size: 26rpx; padding: 30rpx 0; }
