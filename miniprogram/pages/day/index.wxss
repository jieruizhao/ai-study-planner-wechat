.nav-row { display: flex; align-items: center; padding: 8rpx 0 26rpx; }
.nav-back {
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: var(--ink);
}
.nav-center { flex: 1; text-align: center; }
.sec-head { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 6rpx 20rpx; }
.sec-title { font-size: 32rpx; font-weight: 700; }
.add-task-link { color: var(--brand); font-size: 26rpx; padding: 12rpx 6rpx; }
.task-field { height: 80rpx; line-height: 80rpx; border-bottom: 1rpx solid var(--line); color: var(--ink); font-size: 28rpx; }
.task-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.task-actions .btn { flex: 1; margin: 0; font-size: 28rpx; }
.task-row-actions { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; margin-left: 16rpx; }
.task-edit, .task-delete { font-size: 24rpx; padding: 10rpx 8rpx; }
.task-edit { color: var(--brand); }
.task-delete { color: var(--danger); }

.pill-plan {
  font-family: var(--serif);
  font-size: 20rpx; letter-spacing: 2rpx;
  border: 2rpx solid var(--line); border-radius: 999rpx;
  padding: 8rpx 18rpx; color: var(--ink-2);
  margin-right: 20rpx; flex-shrink: 0;
}
.log-min { font-size: 34rpx; font-weight: 700; min-width: 100rpx; }
.empty-card { padding: 50rpx 30rpx; }
.empty-doodle { color: var(--accent); letter-spacing: 6rpx; opacity: 0.7; }
.empty-btn { display: inline-block; padding: 18rpx 44rpx; margin-top: 28rpx; }
